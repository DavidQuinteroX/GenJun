<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CamionesWeb.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %> - Sistema de Gestión de Transporte</title>

    <!-- Bootstrap + Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Site CSS -->
    <link href="~/Content/Site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
</head>

<body>

<form runat="server">

    <asp:ScriptManager runat="server">
        <Scripts>
            <asp:ScriptReference Name="MsAjaxBundle" />
            <asp:ScriptReference Name="jquery" />
            <asp:ScriptReference Name="WebFormsBundle" />
        </Scripts>
    </asp:ScriptManager>

    <!-- NAVBAR GLOBAL -->
    <nav class="navbar navbar-expand-lg navbar-glass" id="mainNavbar">
        <div class="container">

            <a class="navbar-brand" runat="server" href="~/Default.aspx">
                <span class="brand-icon">
                    <i class="fa-solid fa-truck-fast"></i>
                </span>
                <span>Sistema de Transporte</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainMenu">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Default.aspx">Inicio</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Camiones">Camiones</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Choferes">Choferes</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Rutas">Rutas</a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" runat="server" href="~/Contact">Contacto</a>
                    </li>

                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a class="btn btn-login" href="#">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Iniciar Sesión
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <!-- CONTENIDO GLOBAL -->
    <main class="main-content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

</form>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- TU JS -->
<script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>

<!-- NAV SCROLL EFFECT -->
<script>
    (function () {
        var nav = document.getElementById('mainNavbar');

        function onScroll() {
            if (window.scrollY > 30)
                nav.classList.add('scrolled');
            else
                nav.classList.remove('scrolled');
        }

        window.addEventListener('scroll', onScroll);
        onScroll();
    })();
</script>

</body>
</html>