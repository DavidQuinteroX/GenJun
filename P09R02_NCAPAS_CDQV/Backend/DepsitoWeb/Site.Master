<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="DepsitoWeb.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Sistema de Gestión de Depósito</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/dashboard.css" rel="stylesheet" runat="server" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- DataTables -->
    <link rel="stylesheet"
        href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.css" />

    <!-- Animate.css -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

</head>

<body>

    <form runat="server">

        <asp:ScriptManager runat="server">
            <Scripts>
                <%-- Framework Scripts --%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>
       
        <nav class="navbar navbar-expand-lg navbar-dashboard">

            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand d-flex align-items-center"
                    runat="server"
                    href="~/">

                    <span class="material-icons brand-icon">sports_bar</span>

                    <div>
                        <div class="brand-title">BeerStock</div>
                        <small class="brand-subtitle">
                            Sistema Administrativo
                        </small>
                    </div>

                </a>

                <!-- RESPONSIVE -->
                <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- MENU -->
                <div class="navbar-collapse flex-grow-1" id="menuPrincipal">

                    <div class="d-flex w-100 align-items-center">

                        <ul class="navbar-nav flex-nowrap me-auto">

                            <!-- Inicio -->
                            <li class="nav-item">
                                <a class="nav-link"
                                    runat="server"
                                    href="~/">
                                    <span class="material-icons nav-icon">home</span>
                                    Inicio
                                </a>
                            </li>

                            <!-- Catálogos -->
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                    href="#"
                                    role="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                    <span class="material-icons nav-icon">category</span>
                                    Catálogos

                                </a>

                                <ul class="dropdown-menu shadow">

                                    <li>
                                        <a class="dropdown-item"
                                            runat="server"
                                            href="~/Categorias.aspx">
                                            <span class="material-icons">category</span>
                                            Categorías
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                            runat="server"
                                            href="~/Productos.aspx">
                                            <span class="material-icons">inventory_2</span>
                                            Productos
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                            runat="server"
                                            href="~/Marcas.aspx">
                                            <span class="material-icons">workspace_premium</span>
                                            Marcas
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                            runat="server"
                                            href="~/Presentaciones.aspx">
                                            <span class="material-icons">view_module</span>
                                            Presentaciones
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                            runat="server"
                                            href="~/Precios.aspx">
                                            <span class="material-icons">sell</span>
                                            Precios
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <!-- Inventario -->
                            <li class="nav-item">
                                <a class="nav-link"
                                    runat="server"
                                    href="~/Inventario.aspx">
                                    <span class="material-icons nav-icon">warehouse</span>
                                    Inventario
                                </a>
                            </li>

                            <!-- Movimientos -->
                            <li class="nav-item">
                                <a class="nav-link"
                                    runat="server"
                                    href="~/MovimientosInventario.aspx">
                                    <span class="material-icons nav-icon">sync_alt</span>
                                    Movimientos
                                </a>
                            </li>

                            <!-- Clientes -->
                            <li class="nav-item">
                                <a class="nav-link"
                                    runat="server"
                                    href="~/Clientes.aspx">
                                    <span class="material-icons nav-icon">groups</span>
                                    Clientes
                                </a>
                            </li>

                            <!-- Ventas -->
                            <li class="nav-item">
                                <a class="nav-link"
                                    runat="server"
                                    href="~/Ventas.aspx">
                                    <span class="material-icons nav-icon">point_of_sale</span>
                                    Ventas
                                </a>
                            </li>

                        </ul>

                        <!-- Usuario -->
                        <ul class="navbar-nav navbar-user">

                            <li class="nav-item dropdown navbar-user">

                                <a class="nav-link dropdown-toggle"
                                    href="#"
                                    data-bs-toggle="dropdown">

                                    <span class="material-icons">account_circle</span>
                                    Administrador

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <span class="material-icons">settings</span>
                                            Configuración
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>

                                    <li>
                                        <a class="dropdown-item text-danger" href="#">
                                            <span class="material-icons">logout</span>
                                            Cerrar sesión
                                        </a>
                                    </li>

                                </ul>

                            </li>

                        </ul>

                    </div>

                </div>

        </nav>

        <div class="container-fluid px-4 mt-4">

            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>

            <hr />

            <footer class="footer-dashboard mt-5">

                <div class="container-fluid">

                    <div class="row align-items-center">

                        <div class="col-md-6 text-center text-md-start">

                            <strong>BeerStock</strong>

                            <span class="footer-separator">|</span>

                            Sistema de Gestión para Depósito de Bebidas

                        </div>

                        <div class="col-md-6 text-center text-md-end">

                            <span class="material-icons footer-icon">verified</span>

                            Versión 1.0

                            <span class="footer-separator">|</span>

                            © <%: DateTime.Now.Year %>

                        </div>

                    </div>

                </div>

            </footer>

        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>

</html>