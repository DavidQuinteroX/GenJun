@model IEnumerable<P15R01_MVC_CDQV.Camiones>

@{
    ViewBag.Title = "Monitoreo";
}


<main class="app-main">

    <section class="app-section active" id="section-monitor">

        <div class="container-xxl">


            <div class="section-head">

                <div>

                    <span class="eyebrow noc-eyebrow">
                        <i class="bi bi-broadcast-pin"></i>
                        NOC · Network Operations Center
                    </span>


                    <h1 class="section-title">
                        Monitoreo en tiempo real
                    </h1>


                    <p class="section-sub">
                        Seguimiento GPS simulado de unidades.
                    </p>


                </div>


                <div class="d-flex gap-2">


                    <span class="glass-chip">
                        <i class="bi bi-circle-fill text-success pulse-dot"></i>
                        Sistema en línea
                    </span>


                    <span class="glass-chip">
                        <i class="bi bi-cpu"></i>
                        Latencia 24 ms
                    </span>


                </div>


            </div>




            <div id="monitorGrid" class="row g-4"></div>



            <div id="monitorEmpty"
                 class="glass-card p-5 text-center d-none">


                <i class="bi bi-radar fs-1 text-info mb-3 d-block"></i>


                <h4>
                    Sin rutas activas
                </h4>


                <p class="text-muted">
                    No existen unidades en curso.
                </p>


            </div>



        </div>

    </section>

</main>




<script>


    /* ==============================
       STORAGE
    ================================ */

    const KEY = "MONITOR_ROUTES";


    const MonitorStore = {


        get() {

            let data = localStorage.getItem(KEY);

            return data ? JSON.parse(data) : [];

        },


        save(data) {

            localStorage.setItem(
                KEY,
                JSON.stringify(data)
            );

        }

    };





    /* ==============================
       DATOS
    ================================ */


    let rutas = MonitorStore.get();



    if (rutas.length === 0) {

        rutas = [

            {
                id: 1,
                origin: "CDMX",
                destination: "Puebla",
                truck: "CCR-001",
                driver: "Carlos Ramírez",
                km: 135,
                progress: 35,
                status: "En Curso",
                departure: "08:00",
                eta: "10:30"
            }


        ];


        MonitorStore.save(rutas);

    }





    /* ==============================
       RENDER GPS
    ================================ */


    function renderMonitor() {


        let active =
            rutas.filter(x => x.status === "En Curso");


        let grid =
            document.getElementById("monitorGrid");


        let empty =
            document.getElementById("monitorEmpty");



        if (active.length === 0) {

            grid.innerHTML = "";

            empty.classList.remove("d-none");

            return;

        }



        empty.classList.add("d-none");



        grid.innerHTML =
            active.map(r => {


                let progress =
                    Math.round(r.progress);



                let recorrido =
                    (r.km * progress / 100).toFixed(1);



                let restante =
                    (r.km - recorrido).toFixed(1);



                return `


<div class="col-12">


<div class="monitor-card">



<div class="mc-head">


<div>


<div class="mc-route">

<i class="bi bi-geo-alt-fill text-info"></i>

${r.origin}

<i class="bi bi-arrow-right text-info"></i>

${r.destination}

</div>



<div class="mc-sub">

Chofer:

<b class="text-white">
${r.driver}
</b>


· Unidad:

<b class="text-white">
${r.truck}
</b>


</div>



</div>



<span class="glass-chip">

<i class="bi bi-broadcast-pin text-info"></i>

Transmitiendo

</span>



</div>





<div class="gps-track">


<div class="gps-labels">


<div>

<i class="bi bi-record-circle text-info"></i>

${r.origin}

<small>
Salida ${r.departure}
</small>

</div>



<div class="text-end">


<i class="bi bi-flag-fill text-success"></i>

${r.destination}


<small>
ETA ${r.eta}
</small>


</div>


</div>





<div class="gps-line">


<div class="gps-end start"></div>


<div class="gps-progress"
style="width:${progress}%">

</div>



<div class="gps-truck"
style="left:${progress}%">

<i class="bi bi-truck"></i>

</div>



<div class="gps-end finish"></div>


</div>


</div>





<div class="mc-meta">


<div class="mc-stat">

<div class="label">
Velocidad
</div>

<div class="value">
${60 + Math.floor(Math.random() * 40)} km/h
</div>

</div>



<div class="mc-stat">

<div class="label">
Recorrido
</div>

<div class="value">
${recorrido} km
</div>

</div>




<div class="mc-stat">

<div class="label">
Restante
</div>

<div class="value">
${restante} km
</div>

</div>



<div class="mc-stat">

<div class="label">
Progreso
</div>

<div class="value">
${progress}%
</div>

</div>



</div>




</div>


</div>


`;



            }).join("");



    }






    /* ==============================
       SIMULADOR GPS
    ================================ */


    function tickMonitor() {


        rutas.forEach(r => {


            if (r.status === "En Curso") {


                r.progress +=
                    Math.random() * 2;



                if (r.progress >= 100) {

                    r.progress = 100;

                    r.status = "Completada";

                }


            }


        });



        MonitorStore.save(rutas);


        renderMonitor();


    }





    /* ==============================
       ARRANQUE
    ================================ */


    document.addEventListener(
        "DOMContentLoaded",
        () => {


            renderMonitor();



            setInterval(
                tickMonitor,
                2500
            );



        });



</script>