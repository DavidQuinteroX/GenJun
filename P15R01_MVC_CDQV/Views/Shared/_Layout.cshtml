<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

</head>
<body>
    <!-- Background FX -->
    <div class="bg-fx">
        <div class="bg-orb orb-1"></div>
        <div class="bg-orb orb-2"></div>
        <div class="bg-orb orb-3"></div>
        <div class="bg-grid"></div>
    </div>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg fixed-top glass-navbar">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#" data-section="dashboard">
                <span class="brand-logo"><i class="bi bi-truck-front-fill"></i></span>
                <span class="brand-text">GESTIÓN <span class="brand-accent">CCR</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <i class="bi bi-list text-white fs-3"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link nav-pill @(controller=="Home" ? "active" : "")"
                           href="@Url.Action("Index","Home")">
                            <i class="bi bi-speedometer2"></i>
                            Inicio
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link nav-pill @(controller=="Camiones" ? "active" : "")"
                           href="@Url.Action("Index","Camiones")">
                            <i class="bi bi bi-truck"></i>
                            Camiones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-pill @(controller=="Choferes" ? "active" : "")"
                           href="@Url.Action("Index","Choferes")">
                            <i class="bi bi-speedometer2"></i>
                            Choferes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-pill @(controller=="Rutas" ? "active" : "")"
                           href="@Url.Action("Index","Rutas")">
                            <i class="bi bi-person-badge"></i>
                            Rutas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-pill @(controller=="Monitoreo" ? "active" : "")"
                           href="@Url.Action("Index","Monitoreo")">
                            <i class="bi bi-broadcast-pin"></i>
                            Monitoreo
                        </a>
                    </li>

                    
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Mi aplicación ASP.NET</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script src="~/Scripts/Camiones/Camiones.js"></script>
</body>
</html>
